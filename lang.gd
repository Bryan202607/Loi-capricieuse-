extends RefCounted
# Langues du jeu. Le français est la langue d'origine : chaque texte français sert de clé.
# Pour ajouter une langue : un nouveau dictionnaire ci-dessous + une entrée dans CODES / NAMES.

const CODES := ["fr", "en", "es"]
const NAMES := ["FRANÇAIS", "ENGLISH", "ESPAÑOL"]

static var code := "fr"


static func t(s: String) -> String:
	if code == "en" and EN.has(s):
		return EN[s]
	if code == "es" and ES.has(s):
		return ES[s]
	return s


static func next_code() -> String:
	var i := CODES.find(code)
	return CODES[(i + 1) % CODES.size()]


static func name_of(c: String) -> String:
	return NAMES[maxi(CODES.find(c), 0)]


